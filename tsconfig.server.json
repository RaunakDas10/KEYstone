{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["server", "src/types", "src/mock"]
}
