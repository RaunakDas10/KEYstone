# Server Configuration
PORT=5000

# MongoDB Connection String (Local instance or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/keystone
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/keystone?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/keystone

# Gemini AI Mode (server-only; never expose this key through VITE_ variables)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash

# Email verification (use a Gmail App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
# Generate a long random value for production. If unset, SMTP_PASS is used.
AUTH_OTP_SECRET=replace_with_a_long_random_secret

# Google OAuth web client ID. Add your local and deployed origins in Google
# Cloud Console's Authorized JavaScript origins.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
