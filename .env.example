# Server Configuration
PORT=5000

# MongoDB Connection String (Local instance or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/keystone
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/keystone?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/keystone

# Gemini AI Mode (server-only; never expose this key through VITE_ variables)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
